      },
      "83e4c7f8-f974-4e6d-a95e-8aecf4da659e": {
        "id": "83e4c7f8-f974-4e6d-a95e-8aecf4da659e",
        "message": {
          "id": "83e4c7f8-f974-4e6d-a95e-8aecf4da659e",
          "author": {
            "role": "user",
            "metadata": {}
          },
          "create_time": 1789725600.0,
          "content": {
            "content_type": "text",
            "parts": [
              "When should I use git rebase instead of merge?"
            ]
          },
          "metadata": {}
        },
        "parent": "7e5cae6a-35ea-4eb0-94ab-142803c31158",
        "children": [
          "e9accac1-e0a2-4c15-9e35-59aed1e502c4"
        ]
      },
      "e9accac1-e0a2-4c15-9e35-59aed1e502c4": {
        "id": "e9accac1-e0a2-4c15-9e35-59aed1e502c4",
        "message": {
          "id": "e9accac1-e0a2-4c15-9e35-59aed1e502c4",
          "author": {
            "role": "assistant",
            "metadata": {}
          },
          "create_time": 1789725720.0,
          "content": {
            "content_type": "text",
            "parts": [
              "Rebase your local feature branch onto main to keep a linear history before opening a PR. Use merge for shared branches, because rebasing rewrites commits and breaks collaborators' history."
            ]
          },
          "metadata": {}
        },
        "parent": "83e4c7f8-f974-4e6d-a95e-8aecf4da659e",
        "children": []
      }
    },
    "current_node": "e9accac1-e0a2-4c15-9e35-59aed1e502c4"
  },
