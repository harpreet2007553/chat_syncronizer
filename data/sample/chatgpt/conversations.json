    "title": "Git rebase vs merge",
    "create_time": 1789725600.0,
    "update_time": 1789725840.0,
    "mapping": {
      "7e5cae6a-35ea-4eb0-94ab-142803c31158": {
        "id": "7e5cae6a-35ea-4eb0-94ab-142803c31158",
        "message": null,
        "parent": null,
        "children": [
          "83e4c7f8-f974-4e6d-a95e-8aecf4da659e"
