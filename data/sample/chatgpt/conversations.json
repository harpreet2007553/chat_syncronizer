  {
    "id": "c09",
    "conversation_id": "c09",
    "title": "Chunking strategy for chat logs",
    "create_time": 1789466400.0,
    "update_time": 1789466880.0,
    "mapping": {
      "e3b2dda8-88cd-4daa-885a-273a035bcd4e": {
        "id": "e3b2dda8-88cd-4daa-885a-273a035bcd4e",
        "message": null,
        "parent": null,
        "children": [
          "47b5d802-ca2a-45f0-961d-f27c2d2ddf86"
        ]
      },
      "47b5d802-ca2a-45f0-961d-f27c2d2ddf86": {
        "id": "47b5d802-ca2a-45f0-961d-f27c2d2ddf86",
        "message": {
          "id": "47b5d802-ca2a-45f0-961d-f27c2d2ddf86",
          "author": {
            "role": "user",
            "metadata": {}
          },
          "create_time": 1789466400.0,
          "content": {
            "content_type": "text",
            "parts": [
              "How should I chunk chat history for RAG? Fixed size feels wrong."
            ]
          },
          "metadata": {}
        },
        "parent": "e3b2dda8-88cd-4daa-885a-273a035bcd4e",
        "children": [
          "985c6d3b-ed5c-493d-b2c5-bfc27decaf69"
        ]
      },
      "985c6d3b-ed5c-493d-b2c5-bfc27decaf69": {
        "id": "985c6d3b-ed5c-493d-b2c5-bfc27decaf69",
        "message": {
          "id": "985c6d3b-ed5c-493d-b2c5-bfc27decaf69",
          "author": {
            "role": "assistant",
            "metadata": {}
          },
          "create_time": 1789466520.0,
          "content": {
            "content_type": "text",
            "parts": [
              "Chat data has natural units. Try a question-answer pair as one chunk, or a sliding window of 3 turns with 1 turn of overlap. Keep metadata such as conversation id, timestamp and role so you can cite and filter."
            ]
          },
          "metadata": {}
        },
        "parent": "47b5d802-ca2a-45f0-961d-f27c2d2ddf86",
        "children": [
          "cc136b58-50a8-40a9-91af-52ef2dd2154b"
        ]
      },
      "cc136b58-50a8-40a9-91af-52ef2dd2154b": {
        "id": "cc136b58-50a8-40a9-91af-52ef2dd2154b",
        "message": {
          "id": "cc136b58-50a8-40a9-91af-52ef2dd2154b",
          "author": {
            "role": "user",
            "metadata": {}
          },
          "create_time": 1789466640.0,
          "content": {
            "content_type": "text",
            "parts": [
              "What about very long assistant answers with code?"
            ]
          },
          "metadata": {}
        },
        "parent": "985c6d3b-ed5c-493d-b2c5-bfc27decaf69",
        "children": [
          "c59e61b6-1711-4062-94b2-456c280bf49a"
        ]
      },
      "c59e61b6-1711-4062-94b2-456c280bf49a": {
        "id": "c59e61b6-1711-4062-94b2-456c280bf49a",
        "message": {
          "id": "c59e61b6-1711-4062-94b2-456c280bf49a",
          "author": {
            "role": "assistant",
            "metadata": {}
          },
          "create_time": 1789466760.0,
          "content": {
            "content_type": "text",
            "parts": [
              "Split long answers on code-block and paragraph boundaries, and prepend the user question to each piece so every chunk stays self-contained."
            ]
          },
          "metadata": {}
        },
        "parent": "cc136b58-50a8-40a9-91af-52ef2dd2154b",
        "children": []
      }
    },
    "current_node": "c59e61b6-1711-4062-94b2-456c280bf49a"
  },
